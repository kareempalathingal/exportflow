rules_version = '2';

// ExportFlow security rules (Phases 1–3).
// - Only members of a workspace can read or write inside it.
// - Each user owns exactly two workspaces: <uid>_actual and <uid>_demo.
// - Every record write must bump `rev` by exactly one (optimistic concurrency):
//   a stale offline write is rejected instead of silently overwriting.
// - Every record write must be paired with an audit event in the same batch.
// - Audit events are append-only.
// - Anything not explicitly allowed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownWorkspaceId(wsId) {
      return signedIn() && wsId in [request.auth.uid + '_actual', request.auth.uid + '_demo'];
    }

    function wsPath(wsId) {
      return /databases/$(database)/documents/workspaces/$(wsId);
    }

    function isMember(wsId) {
      return signedIn()
        && exists(wsPath(wsId))
        && request.auth.uid in get(wsPath(wsId)).data.members;
    }

    function auditPath(wsId, eventId) {
      return /databases/$(database)/documents/workspaces/$(wsId)/auditEvents/$(eventId);
    }

    // The audit event named in lastAuditId must be created in the same batch
    // and describe this exact write.
    function auditPaired(wsId, docId) {
      let d = request.resource.data;
      let evPath = auditPath(wsId, d.lastAuditId);
      return d.lastAuditId is string
        && !exists(evPath)
        && existsAfter(evPath)
        && getAfter(evPath).data.entityId == docId
        && getAfter(evPath).data.rev == d.rev;
    }

    function stamped() {
      let d = request.resource.data;
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    function validCreate(wsId, docId) {
      return isMember(wsId)
        && request.resource.data.rev == 1
        && stamped()
        && auditPaired(wsId, docId);
    }

    function validUpdate(wsId, docId) {
      return isMember(wsId)
        && request.resource.data.rev == resource.data.rev + 1
        && stamped()
        && auditPaired(wsId, docId);
    }

    function isMaster(c) {
      return c in ['customers', 'products', 'rawMaterials', 'boms', 'suppliers', 'processes'];
    }

    function namedRecord() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200 && d.active is bool;
    }

    function validMaster(c, docId) {
      let d = request.resource.data;
      return (c == 'customers' && namedRecord())
        || (c == 'products' && namedRecord() && d.baseUnit is string
            && d.supplyType in ['MANUFACTURED', 'TRADED', 'BOTH'])
        || (c == 'rawMaterials' && namedRecord() && d.baseUnit is string)
        || (c == 'boms' && d.productId == docId && d.lines is list && d.lines.size() <= 100)
        || (c == 'suppliers' && namedRecord() && d.items is list && d.items.size() <= 500)
        || (c == 'processes' && namedRecord());
    }

    // The BOM is written per base unit, so the base unit is fixed once created.
    function baseUnitUnchanged(c) {
      return !(c in ['products', 'rawMaterials'])
        || request.resource.data.baseUnit == resource.data.baseUnit;
    }

    // ---- Phase 3: Job Orders --------------------------------------------
    function isDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validJobOrder(d) {
      return d.joNumber is string && d.joNumber.size() > 0 && d.joNumber.size() <= 60
        && d.customerId is string && d.customerId.size() > 0
        && isDate(d.receivedDate) && isDate(d.deliveryDate)
        && d.deliveryDate > d.receivedDate
        && d.deliveryDateType in ['UNCONFIRMED', 'FACTORY_DISPATCH', 'PORT', 'CUSTOMER_DESTINATION']
        && d.deadline is map && d.deadline.ruleVersion is string
        && isDate(d.deadline.internalDeadline)
        && d.deadline.internalDeadline >= d.receivedDate
        && d.deadline.internalDeadline < d.deliveryDate
        && d.status in ['DRAFT', 'CONFIRMED', 'COMPLETED', 'CANCELLED']
        && d.lines is list && d.lines.size() <= 200
        && (d.status in ['DRAFT', 'CANCELLED'] || d.bomSnapshot is map);
    }

    function allowedTransition(from, to) {
      return (from == 'DRAFT' && to in ['DRAFT', 'CONFIRMED', 'CANCELLED'])
        || (from == 'CONFIRMED' && to in ['CONFIRMED', 'COMPLETED', 'CANCELLED'])
        || (from == 'COMPLETED' && to == 'CONFIRMED')
        || (from == 'CANCELLED' && to == 'DRAFT');
    }

    // Cancelling and reopening need a reason in the audit event (edits do not).
    function reasonGiven(wsId) {
      let r = getAfter(auditPath(wsId, request.resource.data.lastAuditId)).data.reason;
      return r is string && r.size() > 0;
    }

    function needsReason(from, to) {
      return to == 'CANCELLED' || from in ['COMPLETED', 'CANCELLED'];
    }

    // ---- Phase 3b: manual stock counts (one per item, latest count) ------
    function validStockCount(d, docId) {
      return d.itemType in ['RAW_MATERIAL', 'PRODUCT']
        && d.itemId is string && d.itemId.size() > 0
        && docId == d.itemType + '_' + d.itemId
        && d.qty is number && d.qty >= 0
        && d.unit is string
        && isDate(d.countedOn);
    }

    match /workspaces/{wsId} {
      allow get: if ownWorkspaceId(wsId)
        && (resource == null || request.auth.uid in resource.data.members);
      allow list: if false;
      allow create: if ownWorkspaceId(wsId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.mode == (wsId == request.auth.uid + '_actual' ? 'ACTUAL' : 'DEMO');
      allow update, delete: if false;

      match /auditEvents/{eventId} {
        allow read: if isMember(wsId);
        allow create: if isMember(wsId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.entityId is string
          && request.resource.data.entity is string
          && request.resource.data.action in ['CREATE', 'UPDATE', 'RESOLVE_CONFLICT']
          && request.resource.data.rev is int
          && request.resource.data.changes is list;
        allow update, delete: if false;
      }

      // Work calendar (weekly off days + company holidays); other settings docs unchanged.
      function validSettings(docId, d) {
        return docId != 'calendar'
          || (d.weeklyOff is list && d.weeklyOff.size() < 7 && d.holidays is map && d.holidays.size() <= 1000);
      }

      // Versioned business records. New collections are added here per phase.
      match /settings/{docId} {
        allow read: if isMember(wsId);
        allow create: if validCreate(wsId, docId) && validSettings(docId, request.resource.data);
        allow update: if validUpdate(wsId, docId) && validSettings(docId, request.resource.data);
        allow delete: if false;
      }

      // Phase 2 masters. Records are never deleted; they are made inactive.
      match /{masterCollection}/{docId} {
        allow read: if isMember(wsId) && isMaster(masterCollection);
        allow create: if isMaster(masterCollection) && validCreate(wsId, docId) && validMaster(masterCollection, docId);
        allow update: if isMaster(masterCollection) && validUpdate(wsId, docId) && validMaster(masterCollection, docId)
          && baseUnitUnchanged(masterCollection);
        allow delete: if false;
      }

      match /stockCounts/{docId} {
        allow read: if isMember(wsId);
        allow create: if validCreate(wsId, docId) && validStockCount(request.resource.data, docId);
        allow update: if validUpdate(wsId, docId) && validStockCount(request.resource.data, docId);
        allow delete: if false;
      }

      // Phase 3 Job Orders. Created as Draft; never deleted (cancel instead).
      match /jobOrders/{docId} {
        allow read: if isMember(wsId);
        allow create: if validCreate(wsId, docId)
          && validJobOrder(request.resource.data)
          && request.resource.data.status == 'DRAFT';
        allow update: if validUpdate(wsId, docId)
          && validJobOrder(request.resource.data)
          && allowedTransition(resource.data.status, request.resource.data.status)
          && (!needsReason(resource.data.status, request.resource.data.status) || reasonGiven(wsId));
        allow delete: if false;
      }
    }
  }
}
